# URL API backend (apps/api)
VITE_API_URL=http://localhost:3000

# true = paksa gambar dummy (picsum) via imgFor() + dataset dummy.ts.
# Pasang true di Vercel, biarkan unset/false di lokal agar pakai API asli.
VITE_USE_DUMMY_IMAGES=false

# true = peta Nusantara pakai dataset dummy.
# Default false (foto database). Set true bila tanpa backend.
VITE_USE_DUMMY_MAP=false
# SEO: alamat kanonis situs (tanpa garis miring akhir), mis. https://lakuna.id — isi begitu domain resmi aktif.
# Kosong = host yang sedang melayani dipakai sebagai alamat kanonis, sitemap, dan og:url.
VITE_SITE_URL=
# Kode verifikasi Google Search Console & Bing Webmaster Tools (metode tag HTML) — opsional.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
# Hanya server (Docker dev): alamat API dari dalam container frontend untuk load SSR, sitemap, og image.
# API_INTERNAL_URL=http://api:3100
